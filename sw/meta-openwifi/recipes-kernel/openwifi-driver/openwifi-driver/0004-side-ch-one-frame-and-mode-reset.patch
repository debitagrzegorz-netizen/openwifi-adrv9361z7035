+/* Register 0 bit 0 resets the m_axis FIFO reader. Bit 2 resets the CSI/IQ
+ * state machines. The hold matches the probe so the XPM FIFO reset finishes.
+ * Config registers are left alone. Both FIFO overflow ports are unconnected,
+ * so there is no overflow flag to count. */
+static u32 side_ch_applied_capture, side_ch_applied_len, side_ch_applied_eq;
+static int side_ch_applied_valid;
+
+static void side_ch_soft_reset(void)
+{
+	int i;
+
+	for (i = 0; i < 8; i++)
+		SIDE_CH_REG_MULTI_RST_write(0);
+	for (i = 0; i < 32; i++)
+		SIDE_CH_REG_MULTI_RST_write(0xFFFFFFFF);
+	for (i = 0; i < 8; i++)
+		SIDE_CH_REG_MULTI_RST_write(0);
+}
+
+static void side_ch_note_mode(void)
+{
+	side_ch_applied_capture = SIDE_CH_REG_IQ_CAPTURE_read() & 1;
+	side_ch_applied_len = SIDE_CH_REG_IQ_LEN_read();
+	side_ch_applied_eq = SIDE_CH_REG_NUM_EQ_read();
+	side_ch_applied_valid = 1;
+}
+
+/* Returns 1 when the live IQ/CSI registers differ from the last armed mode.
+ * The FIFO is empty afterwards. */
+static int side_ch_mode_reset_if_needed(void)
+{
+	u32 capture = SIDE_CH_REG_IQ_CAPTURE_read() & 1;
+	u32 len = SIDE_CH_REG_IQ_LEN_read();
+	u32 eq = SIDE_CH_REG_NUM_EQ_read();
+
+	if (side_ch_applied_valid && capture == side_ch_applied_capture
+	    && len == side_ch_applied_len && eq == side_ch_applied_eq)
+		return 0;
+	printk(KERN_INFO "%s mode change capture %u len %u eq %u\n",
+		side_ch_compatible_str, capture, len, eq);
+	side_ch_soft_reset();
+	side_ch_note_mode();
+	return 1;
+}
