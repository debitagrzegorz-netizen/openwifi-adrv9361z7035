/*
 * OpenWiFi design: delete auto PL nodes re-added/redefined by openwifi.dtsi.
 * No AXI-VDMA / xlnx,axi-vdma nodes exist in SDT pl.dtsi for this XSA.
 * AXI DMA labels below are the OpenWiFi packet DMAs (recreated in openwifi.dtsi).
 */
/delete-node/ &axi_ad9361;
/delete-node/ &misc_clk_0;
/delete-node/ &misc_clk_1;
/delete-node/ &axi_gpreg;
/delete-node/ &axi_iic_main;
/delete-node/ &axi_pz_xcvrlb;
/* OpenWiFi auto-generated nodes — re-added in openwifi.dtsi with sdr,* compatibles */
/delete-node/ &openwifi_ip_axi_dma_0;
/delete-node/ &openwifi_ip_axi_dma_1;
/delete-node/ &openwifi_ip_tx_intf_0;
/delete-node/ &openwifi_ip_rx_intf_0;
/delete-node/ &openwifi_ip_openofdm_tx_0;
/delete-node/ &openwifi_ip_openofdm_rx_0;
/delete-node/ &openwifi_ip_xpu_0;
/delete-node/ &openwifi_ip_side_ch_0;
/* ADI board DTS &rx_dma / &tx_dma (adi,axi-dmac @ 0x7c40xxxx) → openwifi-adi-cleanup.dtsi */

/* SDT pl.dtsi adds these. The v1.0 DTG pl.dtsi did not. Nothing kept references them. */
/delete-node/ &clocking0;
/delete-node/ &clocking1;
/delete-node/ &afi3;
/* Drop the SDT amba_pl bus after its children are gone. OpenWiFi nodes are recreated under &amba. */
/delete-node/ &amba_pl;
