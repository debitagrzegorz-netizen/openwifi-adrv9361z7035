# Copy to config/local.conf. That file is gitignored.
# Absolute paths belong only in the copy.

# Xilinx 2025.1 prefix. It contains Vitis/ and PetaLinux/.
TOOLS_ROOT=

# Source locations default to the URLs in config/versions.conf. To build from a
# local clone instead, uncomment and set a path. An empty value is not a default.
# openwifi checkout that contains OPENWIFI_REV. build.sh clones it into build/src.
#OPENWIFI_REPO=
OPENWIFI_BRANCH=adrv9361z7035-2025.1

# meta-adi checkout at META_ADI_REV (repository root, not meta-adi-xilinx).
# Default: build.sh clones META_ADI_REPO into build/src/meta-adi.
#META_ADI_DIR=

# Optional local checkouts. When one is a local directory, fetch also checks
# that its HEAD is the pinned revision.
#OPENWIFI_HW_REPO=
#ADI_HDL_REPO=
#OPENOFDM_RX_REPO=

# Host path prefixes the hw build must never find in its sources (build guard),
# for example HOST_PATH_GUARD="/path/to/workspace /home/<user>". Empty: no check.
HOST_PATH_GUARD=

# Shared bitbake caches.
DL_DIR=
SSTATE_DIR=
BB_NUMBER_THREADS=8
PARALLEL_MAKE="-j 8"

# Input XSA for single stages. Leave empty to use the XSA from ./build.sh hw
# (./build.sh all always does, unless --xsa is passed). A set XSA must be the
# pinned v1.0 XSA (V1_0_XSA_SHA).
XSA=

# Vivado jobs for ./build.sh hw. Default 8.
HW_JOBS=8

# Reference .hwh for the hardware equivalence gate. A local path, never committed.
# EQUIV_HWH=
# Reference SDT directory (from the v1.0 XSA) for the SDT equivalence gate.
# EQUIV_SDT=
# Reference directory of v1.0 sub-IP xci files (openofdm_rx) for the sub-IP gate.
# EQUIV_SUBIP=

# Set to 1 only when the pinned ADI HDL declares a different Vivado version.
# ADI_IGNORE_VERSION_CHECK=

# Board SSH. The password is SSHPASS in the environment, or extracted at run
# time from OPENWIFI_VALIDATION_SH (a local file, never committed).
BOARD_IP=10.42.0.128
BOARD_USER=analog
BOARD_KNOWN_HOSTS=
OPENWIFI_VALIDATION_SH=
UART_DEV=/dev/ttyUSB0

# Dedicated test dongle. Never set this to the management Wi-Fi interface.
TEST_RADIO_IF=wlx1005014f5b7c
HOST_IP=
IPERF3=
IPERF_LIB=
